# Local default is a SQLite file in instance/. For Postgres (e.g. Neon) paste the
# connection string, e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///internships.db
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
NOTIFY_TO_EMAIL=your_email@gmail.com
SCRAPE_INTERVAL_HOURS=6
# Set to true to run the in-process scheduler (local use, single process only).
# In production the scrape runs from .github/workflows/scrape.yml instead.
RUN_SCHEDULER=false
